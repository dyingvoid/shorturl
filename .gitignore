# Compiled binaries and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries (generated by 'go test -c')
*.test

# Output of the go coverage tool, handling development/test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Go Workspace files
go.work
go.work.sum

# Dependency directories (Uncomment if you want to exclude local vendoring)
# vendor/

# Environment files
.env
.env.local

# IDE/Editor specific files (Optional but highly recommended)
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
